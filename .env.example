# ── Required for features to work ──
SECRET_KEY=change-this-in-production
TELEGRAM_BOT_TOKEN=
KOREAEXIM_AUTHKEY=

# ── Optional (sensible defaults exist in config.py) ──
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
ALERTS_TABLE_NAME=currency-alerts
USERS_TABLE_NAME=users
EXCHANGE_RATES_TABLE_NAME=exchange-rates
RATE_HISTORY_TABLE_NAME=rate-history
NOTIFICATION_HISTORY_TABLE_NAME=notification-history
EVENTBRIDGE_BUS=currency-events
AWS_REGION=ap-northeast-2
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Optional — Google OAuth (leave empty to disable) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
